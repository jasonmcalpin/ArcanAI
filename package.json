{
  "name": "arcanai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build --workspace=@arcanai/plugin-ollama && npm run build --workspace=@arcanai/plugin-transformersjs && npm run build --workspace=@arcanai/plugin-openai-compatible && npm run build --workspace=@arcanai/plugin-openai && npm run build --workspace=@arcanai/plugin-anthropic",
    "test": "npm run build && node --test dist/test/*.test.js plugins/ollama/test/*.test.mjs plugins/openai-compatible/test/*.test.mjs plugins/openai/test/*.test.mjs plugins/anthropic/test/*.test.mjs plugins/transformersjs/test/*.test.mjs test/consumer-import.test.mjs",
    "prepare": "npm run build",
    "smoke:node:transformers": "npm run build && node scripts/smoke-headless-transformers.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "@huggingface/transformers": "4.3.2"
  },
  "workspaces": [
    "plugins/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./node/cards": {
      "types": "./dist/src/node/cards.d.ts",
      "default": "./dist/src/node/cards.js"
    },
    "./plugins/transformersjs": {
      "types": "./plugins/transformersjs/dist/index.d.ts",
      "default": "./plugins/transformersjs/dist/index.js"
    },
    "./plugins/ollama": {
      "types": "./plugins/ollama/dist/index.d.ts",
      "default": "./plugins/ollama/dist/index.js"
    },
    "./plugins/openai-compatible": {
      "types": "./plugins/openai-compatible/dist/index.d.ts",
      "default": "./plugins/openai-compatible/dist/index.js"
    },
    "./plugins/openai": {
      "types": "./plugins/openai/dist/index.d.ts",
      "default": "./plugins/openai/dist/index.js"
    },
    "./plugins/anthropic": {
      "types": "./plugins/anthropic/dist/index.d.ts",
      "default": "./plugins/anthropic/dist/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src/**",
    "plugins/transformersjs/dist/**",
    "plugins/ollama/dist/**",
    "plugins/openai-compatible/dist/**",
    "plugins/openai/dist/**",
    "plugins/anthropic/dist/**"
  ]
}
