{
  "name": "arcanai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build --workspace=@arcanai/plugin-ollama",
    "test": "npm run build && node --test dist/test/*.test.js plugins/ollama/test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  },
  "workspaces": [
    "plugins/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./node/cards": {
      "types": "./dist/src/node/cards.d.ts",
      "default": "./dist/src/node/cards.js"
    }
  },
  "types": "./dist/src/index.d.ts"
}
